# SAIS Labs Environment Variables (Optional)
# If left unset, the website operates seamlessly with server-side inquiry logging
# and client mailto fallback.

# Optional: Resend API Key for automated server-side email dispatch
# Get an API key from https://resend.com
RESEND_API_KEY=

# Optional: Override recipient email for contact inquiries
# Defaults to siteConfig.contact.email ("contact@saislabs.com") if not set
CONTACT_RECEIVER_EMAIL=
